# Application Settings
APP_NAME=Fikak App API
APP_VERSION=1.0.0
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql://fikak_user:fikak_pass@localhost:5432/fikak_db

# JWT Authentication
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS S3 Configuration (Optional - for file upload testing)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=fikak-uploads

# For local testing with MinIO (S3-compatible):
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=fikak-uploads
# Set endpoint URL in code: http://localhost:9000

# External API Configuration
EXTERNAL_API_URL=https://jsonplaceholder.typicode.com
EXTERNAL_API_KEY=

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
