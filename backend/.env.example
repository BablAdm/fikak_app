# Application Settings
APP_NAME=Fikak App API
APP_VERSION=1.0.0
DEBUG=false

# Database Configuration - uncomment and use your real password
# DATABASE_URL=postgresql://fikak_user:<your-db-password>@localhost:5432/fikak_db

# JWT Authentication - uncomment and set to the output of: openssl rand -hex 32
# SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS S3 Configuration (Optional - for file upload testing)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=fikak-uploads

# For local testing with MinIO (S3-compatible), set AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY to the MinIO root credentials from your root .env
# and point S3_ENDPOINT_URL at the MinIO server:
# S3_ENDPOINT_URL=http://localhost:9000

# External API Configuration
EXTERNAL_API_URL=https://jsonplaceholder.typicode.com
EXTERNAL_API_KEY=

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
