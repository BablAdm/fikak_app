# Copy to .env and fill in, or set these directly in claude_desktop_config.json's
# "env" block for the fikak server (see README.md).

# Absolute path to your fikak_app repo clone (the directory containing
# docker-compose.unified.yml). Required.
FIKAK_REPO_PATH=/Users/you/fikak_app

# Compose file name, relative to FIKAK_REPO_PATH. Usually no need to change.
FIKAK_COMPOSE_FILE=docker-compose.unified.yml

# Frappe backend base URL.
FIKAK_BASE_URL=http://localhost:8000

# Frappe admin credentials, used by fikak_submit_task to authenticate.
# FIKAK_ADMIN_PASSWORD must match the ADMIN_PASSWORD value in your fikak_app/.env
# (find it with: grep '^ADMIN_PASSWORD=' /path/to/fikak_app/.env | cut -d= -f2-)
FIKAK_ADMIN_USERNAME=Administrator
FIKAK_ADMIN_PASSWORD=
