# Copy this file to .env and adjust values. .env is gitignored.

# Bind address. 127.0.0.1 for local dev; set 0.0.0.0 for containers/production.
HOST=127.0.0.1

# Port the server listens on.
PORT=5000

# Flask debug mode. Keep False in production.
DEBUG=False

# CORS allow-list. Comma-separated origins, e.g.
#   ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com
# Use * to allow all origins during local development only.
# Leave unset to disable CORS entirely.
ALLOWED_ORIGINS=
