# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# AWS S3 Configuration (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=fikak-uploads

# JWT Secret (must match backend) - uncomment and set to the output of:
# openssl rand -hex 32
# SECRET_KEY=

# Database password (used by docker-compose.yml) - uncomment and set to the
# output of: openssl rand -hex 16
# POSTGRES_PASSWORD=

# DATABASE_URL is only needed for running the backend outside Docker;
# docker-compose.yml builds it from POSTGRES_PASSWORD automatically.
# The password must match POSTGRES_PASSWORD.
# DATABASE_URL=postgresql://fikak_user:<same-as-POSTGRES_PASSWORD>@localhost:5432/fikak_db

# MinIO credentials (local S3-compatible storage) - uncomment and set
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=

# Frappe stack credentials (used by docker-compose.unified.yml).
# setup.sh generates these automatically - no need to set them by hand.
# DB_PASSWORD=
# ADMIN_PASSWORD=

# Debug mode
DEBUG=false
