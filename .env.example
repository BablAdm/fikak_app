# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# AWS S3 Configuration (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=fikak-uploads

# JWT Secret (must match backend) - generate with: openssl rand -hex 32
SECRET_KEY=

# Database password (used by docker-compose.yml) - generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# Database URL (password must match POSTGRES_PASSWORD)
DATABASE_URL=postgresql://fikak_user:<your-db-password>@localhost:5432/fikak_db

# MinIO credentials (local S3-compatible storage)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Frappe stack credentials (used by docker-compose.unified.yml; setup.sh generates these)
DB_PASSWORD=
ADMIN_PASSWORD=

# Debug mode
DEBUG=false
